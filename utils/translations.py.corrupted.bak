def _repair_mojibake(value: str) -> str:
    if not isinstance(value, str):
        return value
    markers = ("", "", "", "", "", "")
    if not any(m in value for m in markers):
        return value
    try:
        fixed = value.encode("latin1", errors="ignore").decode("utf-8", errors="ignore")
        return fixed or value
    except Exception:
        return value


def _looks_broken_translation(value: str, lang_code: str) -> bool:
    if not isinstance(value, str) or not value:
        return True

    suspect_tokens = ("", "", "", "", "", "", "?")
    if any(token in value for token in suspect_tokens):
        return True

    q_count = value.count("?")
    if q_count >= max(3, len(value) // 3):
        return True

    # Keep short icon-only values untouched (e.g. "?", "?", "...").
    if len(value) <= 4 and not any(ch.isalpha() for ch in value):
        return False

    latin1_noise = sum(1 for ch in value if 0x00A0 <= ord(ch) <= 0x00FF)
    if lang_code == "ar":
        arabic_chars = sum(1 for ch in value if 0x0600 <= ord(ch) <= 0x06FF)
        if arabic_chars == 0 and latin1_noise >= 3:
            return True
        # Reject random non-ASCII gibberish that is not Arabic/English text.
        if arabic_chars == 0:
            has_latin = any(ch.isascii() and ch.isalpha() for ch in value)
            has_non_ascii = any(ord(ch) > 127 for ch in value)
            if has_non_ascii and not has_latin:
                return True
    else:
        if latin1_noise >= max(3, len(value) // 4):
            return True

    return False


def _normalize_translations_in_place() -> None:
    en_map = translations.setdefault("en", {})
    for lang_code, mapping in list(translations.items()):
        if not isinstance(mapping, dict):
            continue
        for key, raw_value in list(mapping.items()):
            if not isinstance(raw_value, str):
                continue
            fixed = _repair_mojibake(raw_value)
            if _looks_broken_translation(fixed, lang_code):
                fallback = _repair_mojibake(str(en_map.get(key, key)))
                mapping[key] = fallback
            else:
                mapping[key] = fixed


def t(lang: str, key: str):
    lang_code = lang if lang in translations else "en"
    raw = translations.get(lang_code, {}).get(
        key, translations.get("en", {}).get(key, key)
    )
    fixed = _repair_mojibake(raw)
    if _looks_broken_translation(fixed, lang_code):
        fallback = _repair_mojibake(translations.get("en", {}).get(key, key))
        return fallback
    return fixed

